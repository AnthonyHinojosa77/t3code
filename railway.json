{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @t3tools/web build && pnpm --filter @t3tools/max-gateway build"
  },
  "deploy": {
    "startCommand": "node --experimental-strip-types packages/max-gateway/src/start.ts",
    "healthcheckPath": "/__max/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "requiredMountPath": "/data"
  }
}

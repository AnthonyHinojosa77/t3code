# Shared by the Railway gateway and the Mini companion. Generate with: openssl rand -hex 32
# Put the same value in both places. Never commit a real value.
MAX_TUNNEL_SECRET=

# Railway gateway. Leave PORT unset on Railway; Railway injects it. HOST defaults to 0.0.0.0.
PORT=
HOST=
# Personal mode is on unless this is exactly false. Only OWNER_EMAIL can register or log in.
OWNER_EMAIL=
MAX_PERSONAL_MODE=
# Optional SQLite file. Unset uses $RAILWAY_VOLUME_MOUNT_PATH/max.sqlite or /data/max.sqlite.
MAX_DB_PATH=
# Optional built web app directory. Unset uses apps/web/dist when that directory exists.
MAX_WEB_DIST=
# Stripe redirect origin. Default http://localhost:5173. Unused while personal mode is on.
FRONTEND_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ALPHA=
STRIPE_PRICE_ALPHA_MONTHLY=
STRIPE_PRICE_ALPHA_YEARLY=
STRIPE_PRICE_OMEGA_MONTHLY=
STRIPE_PRICE_SIGMA_MONTHLY=
STRIPE_PRICE_SIGMA_YEARLY=
STRIPE_PRICE_CREDITS_20=
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_100=

# Mini companion. Public Railway origin, for example https://<service-domain>.
MAX_GATEWAY_URL=
# Optional alias of MAX_GATEWAY_URL.
MAX_TUNNEL_URL=
# Optional. Default http://127.0.0.1:3773
T3_UPSTREAM_HTTP=
# Optional. Default ws://127.0.0.1:3773
T3_UPSTREAM_WS=
# Optional. If set, the companion does not call t3. Leave empty on the Mini.
MAX_COMPANION_BEARER_TOKEN=
# Optional. Default $T3CODE_HOME/max-companion-token.json or ~/.t3/max-companion-token.json
MAX_COMPANION_TOKEN_PATH=
# Optional. Default 365d.
MAX_COMPANION_TOKEN_TTL=
# Optional path to the t3 binary. Default t3 on PATH.
T3_BIN=
# Optional T3 home. Default ~/.t3.
T3CODE_HOME=

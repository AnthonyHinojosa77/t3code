# Shared by the Railway gateway and the Mini companion. Generate with: openssl rand -hex 32
# Put the same value in both places. Never commit a real value.
MAX_TUNNEL_SECRET=

# Railway gateway. Leave PORT unset on Railway; Railway injects it. HOST defaults to 0.0.0.0.
PORT=
HOST=
# Task 0 stand-in: comma-separated maximus_session values. Task 1 replaces this.
MAX_OWNER_SESSION_ALLOWLIST=

# Mini companion. Public Railway origin, for example https://<service-domain>.
MAX_GATEWAY_URL=
# Optional alias of MAX_GATEWAY_URL.
MAX_TUNNEL_URL=
# Optional. Default http://127.0.0.1:3773
T3_UPSTREAM_HTTP=
# Optional. Default ws://127.0.0.1:3773
T3_UPSTREAM_WS=
# Optional. If set, the companion does not call t3. Leave empty on the Mini.
MAX_COMPANION_BEARER_TOKEN=
# Optional. Default $T3CODE_HOME/max-companion-token.json or ~/.t3/max-companion-token.json
MAX_COMPANION_TOKEN_PATH=
# Optional. Default 365d.
MAX_COMPANION_TOKEN_TTL=
# Optional path to the t3 binary. Default t3 on PATH.
T3_BIN=
# Optional T3 home. Default ~/.t3.
T3CODE_HOME=
